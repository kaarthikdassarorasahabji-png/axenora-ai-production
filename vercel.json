{
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://kaarthikdassarora-axenora-ai-production.hf.space/api/$1"
    },
    {
      "src": "/assets/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    { "handle": "filesystem" },
    {
      "src": "/(?:login|register|forgot-password|reset-password|dashboard(?:/.*)?|admin(?:/.*)?|payment)",
      "dest": "/index.html"
    },
    { "src": "/.*", "dest": "/index.html", "status": 404 }
  ]
}
